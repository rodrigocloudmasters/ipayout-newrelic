      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "account_id": 1468011,
            "description": "Uptime of the services required at 100% on the Test hosts. Uptime is the percentage of winservices samples (every 400s) in the running state over the selected time range.",
            "guid": "MTQ2ODAxMXxWSVp8REFTSEJPQVJEfGRhOjEzMjAxMTU3",
            "id": "MTQ2ODAxMXxWSVp8REFTSEJPQVJEfGRhOjEzMjAxMTU3",
            "name": "Test - Critical Services Uptime",
            "page": [
              {
                "description": "",
                "guid": "MTQ2ODAxMXxWSVp8REFTSEJPQVJEfDUxMDA4NTcw",
                "name": "Overview",
                "widget_area": [],
                "widget_bar": [],
                "widget_billboard": [
                  {
                    "billboard_settings": [],
                    "chart_styles": [],
                    "colors": [],
