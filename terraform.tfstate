                        "query": "FROM Metric SELECT latest(substring(display_name, 0, 40)) AS 'Display Name', latest(state), latest(start_mode) WHERE hostname IN ({{hostname}}) AND service_name IN ({{service_name}}) AND display_name IN ({{display_name}}) AND state IN ({{state}}) AND start_mode IN ({{start}}) AND metricName = 'windows_service_state' AND (hostname LIKE 'UE1-TEST%' OR hostname LIKE 'MIAT-VM%') FACET hostname AS 'Host Name', service_name LIMIT MAX"
