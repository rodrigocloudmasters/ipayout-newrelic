                    "legend_enabled": true,
                    "linked_entity_guids": [],
                    "nrql_query": [
                      {
                        "account_id": "1468011",
                        "query": "SELECT latest(cpuPercent) AS 'CPU %', latest(memoryUsedBytes) * 100 / latest(memoryTotalBytes) AS 'Memory %', latest(uptime) / 86400 AS 'Uptime days', latest(agentVersion) AS 'Agent' FROM SystemSample WHERE hostname LIKE 'UE1-TEST%' AND hostname IN ({{hostname}}) FACET hostname LIMIT MAX"
                      }
                    ],
                    "null_values": [],
