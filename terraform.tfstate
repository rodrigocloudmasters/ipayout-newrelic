    {
      "mode": "managed",
      "type": "newrelic_nrql_alert_condition",
      "name": "data_ingest",
      "provider": "provider[\"registry.terraform.io/newrelic/newrelic\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "account_id": 1468011,
            "aggregation_delay": null,
            "aggregation_method": "event_timer",
            "aggregation_timer": "1200",
            "aggregation_window": 3600,
            "baseline_direction": null,
            "close_violations_on_expiration": true,
            "critical": [
              {
                "disable_event_creation": false,
                "disable_health_status_reporting": false,
                "duration": 0,
                "operator": "above",
                "prediction": [],
                "threshold": 60,
                "threshold_duration": 10800,
                "threshold_occurrences": "all",
                "time_function": ""
              }
            ],
            "description": "Data ingest is running above the expected rate. Multiply the value by 30 for the\nmonthly projection: 50 GB/day is about 1,500 GB/month, 60 GB/day about 1,800.\n\nThe normal rate for this account is around 40 GB/day (~1,200 GB/month). A sustained\njump is almost always a configuration change rather than real growth -- an\nintegration sampling far more often than intended, a new log source, or a\nscrape_interval that was shortened.\n\nTo find the cause:\n\n  SELECT sum(GigabytesIngested) FROM NrConsumption\n  WHERE productLine = 'DataPlatform' FACET usageMetric SINCE 2 days ago\n\nthen drill into whichever bucket grew. For Windows services specifically:\n\n  SELECT rate(bytecountestimate(), 1 day) / 1e9 FROM Metric\n  WHERE metricName = 'windows_service_state' FACET hostname SINCE 1 day ago\n",
            "enabled": true,
            "entity_guid": "MTQ2ODAxMXxBSU9QU3xDT05ESVRJT058Njc5NTg1MDk",
            "evaluation_delay": null,
            "expiration_duration": 21600,
            "fill_option": "none",
            "fill_value": 0,
            "id": "8071540:67958509",
            "ignore_on_expected_termination": false,
            "name": "Data ingest rate is above budget",
            "nrql": [
              {
                "data_account_id": 1468011,
                "evaluation_offset": 0,
                "query": "SELECT rate(sum(GigabytesIngested), 1 day) FROM NrConsumption WHERE productLine = 'DataPlatform'",
                "since_value": ""
              }
            ],
            "open_violation_on_expiration": false,
            "outlier_configuration": [],
            "policy_id": 8071540,
            "runbook_url": "",
            "signal_seasonality": null,
            "slide_by": null,
            "target_entity": "",
            "term": [],
            "timeouts": null,
            "title_template": "Data ingest is running at {{value}} GB/day",
            "type": "static",
            "violation_time_limit": "NON_MATCHABLE_LIMIT_VALUE",
            "violation_time_limit_seconds": 259200,
            "warning": [
              {
                "disable_event_creation": false,
                "disable_health_status_reporting": false,
                "duration": 0,
                "operator": "above",
                "prediction": [],
                "threshold": 50,
                "threshold_duration": 21600,
                "threshold_occurrences": "all",
                "time_function": ""
              }
            ]
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjozMDAwMDAwMDAwMH19",
          "dependencies": [
            "newrelic_alert_policy.data_ingest"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "newrelic_nrql_alert_condition",
      "name": "test_critical_services",
      "provider": "provider[\"registry.terraform.io/newrelic/newrelic\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "account_id": 1468011,
            "aggregation_delay": "120",
            "aggregation_method": "event_flow",
            "aggregation_timer": null,
            "aggregation_window": 600,
            "baseline_direction": null,
            "close_violations_on_expiration": false,
            "critical": [
              {
                "disable_event_creation": false,
                "disable_health_status_reporting": false,
                "duration": 0,
                "operator": "below",
                "prediction": [],
                "threshold": 1,
                "threshold_duration": 600,
                "threshold_occurrences": "all",
                "time_function": ""
              }
            ],
            "description": "One of the services the business requires at 100% uptime is not in the \"running\"\nstate on a Test host.\n\nThe value per host/service pair is 1 while running and 0 while stopped/paused.\nSignal loss is also an alert (open_violation_on_expiration): a service that stops\nreporting was uninstalled, renamed, or the winservices integration on the host\nbroke -- each of those also violates the uptime requirement.\n",
            "enabled": true,
            "entity_guid": "MTQ2ODAxMXxBSU9QU3xDT05ESVRJT058NjgwNzAxNTI",
            "evaluation_delay": null,
            "expiration_duration": 1800,
            "fill_option": "none",
            "fill_value": 0,
            "id": "8086640:68070152",
            "ignore_on_expected_termination": false,
            "name": "Critical service is not running on a Test host",
            "nrql": [
              {
                "data_account_id": 1468011,
                "evaluation_offset": 0,
                "query": "SELECT filter(uniqueCount(entity.guid), WHERE state = 'running') FROM Metric WHERE metricName = 'windows_service_state' AND hostname LIKE 'UE1-TEST%' AND service_name IN ('ipsportalcoreschedulerservice', 'ips_abacollectorservice', 'ips_emailsenderservice', 'ips_feecollector', 'ips_fxservice', 'ips_healthmonitor', 'ips_loadvirtualaccountsservice', 'ripplepaymentsservice', 'ipsripplepaymentsservice') FACET hostname, service_name",
                "since_value": ""
              }
            ],
            "open_violation_on_expiration": true,
            "outlier_configuration": [],
            "policy_id": 8086640,
            "runbook_url": "",
            "signal_seasonality": null,
            "slide_by": null,
            "target_entity": "",
            "term": [],
            "timeouts": null,
            "title_template": "Critical service {{tags.service_name}} is not running on {{tags.hostname}}",
            "type": "static",
            "violation_time_limit": "NON_MATCHABLE_LIMIT_VALUE",
            "violation_time_limit_seconds": 259200,
            "warning": []
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjozMDAwMDAwMDAwMH19",
          "dependencies": [
            "newrelic_alert_policy.test_critical_services"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "newrelic_nrql_alert_condition",
      "name": "test_disk_space",
      "provider": "provider[\"registry.terraform.io/newrelic/newrelic\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "account_id": 1468011,
            "aggregation_delay": "120",
            "aggregation_method": "event_flow",
            "aggregation_timer": null,
            "aggregation_window": 300,
            "baseline_direction": null,
            "close_violations_on_expiration": true,
            "critical": [
              {
                "disable_event_creation": false,
                "disable_health_status_reporting": false,
                "duration": 0,
                "operator": "above",
                "prediction": [],
                "threshold": 90,
                "threshold_duration": 1800,
                "threshold_occurrences": "all",
                "time_function": ""
              }
            ],
            "description": "A volume on a Test host is running out of space. Read the free-space figure\nalongside the percentage: 87% of a 267 GB volume still leaves 34 GB, while 85% of a\n32 GB system drive leaves under 5 GB. The percentage is what can be alerted on\nconsistently across differently sized volumes; the absolute figure decides urgency.\n\nOn the SQL hosts, E: is the volume to watch -- if it holds transaction logs or\ntempdb, SQL Server stops accepting writes when it fills.\n",
            "enabled": true,
            "entity_guid": "MTQ2ODAxMXxBSU9QU3xDT05ESVRJT058Njc5NTIxNzU",
            "evaluation_delay": null,
            "expiration_duration": 3600,
            "fill_option": "none",
            "fill_value": 0,
            "id": "8070699:67952175",
            "ignore_on_expected_termination": false,
            "name": "Test host disk usage is high",
            "nrql": [
              {
                "data_account_id": 1468011,
                "evaluation_offset": 0,
                "query": "SELECT latest(diskUsedPercent) FROM StorageSample WHERE hostname LIKE 'UE1-TEST%' FACET hostname, mountPoint",
                "since_value": ""
              }
            ],
            "open_violation_on_expiration": false,
            "outlier_configuration": [],
            "policy_id": 8070699,
            "runbook_url": "",
            "signal_seasonality": null,
            "slide_by": null,
            "target_entity": "",
            "term": [],
            "timeouts": null,
            "title_template": "Disk {{tags.mountPoint}} on {{tags.hostname}} is above threshold",
            "type": "static",
            "violation_time_limit": "NON_MATCHABLE_LIMIT_VALUE",
            "violation_time_limit_seconds": 259200,
            "warning": [
              {
                "disable_event_creation": false,
                "disable_health_status_reporting": false,
                "duration": 0,
                "operator": "above",
                "prediction": [],
                "threshold": 85,
                "threshold_duration": 3600,
                "threshold_occurrences": "all",
                "time_function": ""
              }
            ]
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjozMDAwMDAwMDAwMH19",
          "dependencies": [
            "newrelic_alert_policy.test_disk_space"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "newrelic_nrql_alert_condition",
      "name": "test_host_down",
      "provider": "provider[\"registry.terraform.io/newrelic/newrelic\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "account_id": 1468011,
            "aggregation_delay": "120",
            "aggregation_method": "event_flow",
            "aggregation_timer": null,
            "aggregation_window": 60,
            "baseline_direction": null,
            "close_violations_on_expiration": true,
            "critical": [
              {
                "disable_event_creation": false,
                "disable_health_status_reporting": false,
                "duration": 0,
                "operator": "below",
                "prediction": [],
                "threshold": 1,
                "threshold_duration": 300,
                "threshold_occurrences": "all",
                "time_function": ""
              }
            ],
            "description": "A Test host has stopped sending data to New Relic. Either the machine is down, the\ninfrastructure agent has stopped, or it lost its route out -- the alert cannot tell\nwhich, so check the host itself first.\n\nThis is a loss-of-signal condition: a dead host sends nothing, so there is no value\nto compare against a threshold. The signal expiring is the alert.\n\nIt only covers hosts that have reported at least once. A host that never had the\nagent installed has no signal to lose and will never appear here -- the \"Hosts\nreporting (of 11)\" tile on the Test Environment dashboard is what catches those.\n",
            "enabled": true,
            "entity_guid": "MTQ2ODAxMXxBSU9QU3xDT05ESVRJT058Njc5NTIxNzY",
            "evaluation_delay": null,
            "expiration_duration": 600,
            "fill_option": "none",
            "fill_value": 0,
            "id": "8070700:67952176",
            "ignore_on_expected_termination": false,
            "name": "Test host stopped reporting",
            "nrql": [
              {
                "data_account_id": 1468011,
                "evaluation_offset": 0,
                "query": "SELECT uniqueCount(hostname) FROM SystemSample WHERE hostname LIKE 'UE1-TEST%' FACET hostname",
                "since_value": ""
              }
            ],
            "open_violation_on_expiration": true,
            "outlier_configuration": [],
            "policy_id": 8070700,
            "runbook_url": "",
            "signal_seasonality": null,
            "slide_by": null,
            "target_entity": "",
            "term": [],
            "timeouts": null,
            "title_template": "Host {{tags.hostname}} stopped reporting to New Relic",
            "type": "static",
            "violation_time_limit": "NON_MATCHABLE_LIMIT_VALUE",
            "violation_time_limit_seconds": 259200,
            "warning": []
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjozMDAwMDAwMDAwMH19",
          "dependencies": [
            "newrelic_alert_policy.test_host_down"
          ]
        }
      ]
    },
