                    "nrql_query": [
                      {
                        "account_id": "1468011",
                        "query": "SELECT count(*) AS 'Not running' FROM (FROM Metric SELECT latest(state) AS 'st' WHERE metricName = 'windows_service_state' AND hostname LIKE 'UE1-TEST%' AND service_name IN ('ipsportalcoreschedulerservice', 'ips_abacollectorservice', 'ips_emailsenderservice', 'ips_feecollector', 'ips_fxservice', 'ips_healthmonitor', 'ips_loadvirtualaccountsservice', 'ripplepaymentsservice', 'ipsripplepaymentsservice') FACET hostname, service_name LIMIT MAX) WHERE st != 'running'"
                      }
                    ],
                    "null_values": [],
                    "refresh_rate": "",
                    "row": 1,
                    "title": "Critical services not running",
                    "units": [],
                    "warning": "",
                    "width": 3,
                    "y_axis_left_max": 0,
                    "y_axis_left_min": 0
                  },
                  {
