                      {
                        "account_id": "1468011",
                        "query": "SELECT latest(disp) AS 'Service', latest(sm) AS 'Start mode' FROM (FROM Metric SELECT latest(state) AS st, latest(start_mode) AS sm, latest(display_name) AS disp WHERE metricName = 'windows_service_state' AND hostname LIKE 'UE1-TEST%' AND hostname IN ({{hostname}}) AND service_name LIKE 'ips%' FACET hostname, service_name LIMIT MAX) WHERE st != 'running' FACET hostname AS 'Host', service_name AS 'Service name' LIMIT MAX"
                      }
