                    "nrql_query": [
                      {
                        "account_id": "1468011",
                        "query": "FROM Metric SELECT uniqueCount(service_name) WHERE hostname IN ({{hostname}}) AND service_name IN ({{service_name}}) AND display_name IN ({{display_name}}) AND state IN ({{state}}) AND start_mode IN ({{start}}) AND metricName = 'windows_service_state' AND (hostname LIKE 'UE1-TEST%' OR hostname LIKE 'MIAT-VM%') FACET start_mode LIMIT MAX"
                      }
                    ],
