                    "initial_sorting": [],
                    "legend_enabled": true,
                    "linked_entity_guids": [],
                    "nrql_query": [
                      {
                        "account_id": "1468011",
                        "query": "SELECT latest(display_name) AS 'Service', latest(st) AS 'State', latest(sm) AS 'Start mode' FROM (FROM Metric SELECT latest(state) AS 'st', latest(start_mode) AS 'sm', latest(display_name) AS 'display_name' WHERE metricName = 'windows_service_state' AND (hostname LIKE 'UE1-TEST%' OR hostname LIKE 'MIAT-VM%') AND (service_name LIKE 'ips%' OR service_name LIKE '%ripplepayments%' OR service_name IN ('w3svc', 'mssqlserver', 'sqlserveragent', 'newrelic-infra')) FACET hostname, service_name LIMIT MAX) WHERE st != 'running' FACET hostname AS 'Host', service_name AS 'Service name' LIMIT MAX"
                      }
                    ],
                    "null_values": [],
                    "refresh_rate": "",
                    "row": 5,
                    "threshold": [],
                    "title": "Which critical services are stopped",
