                      {
                        "account_id": "1468011",
                        "query": "SELECT latest(diskUsedPercent) AS 'Used %', latest(diskFreeBytes) / 1e9 AS 'Free GB', latest(diskTotalBytes) / 1e9 AS 'Total GB' FROM StorageSample WHERE hostname LIKE 'UE1-TEST%' AND hostname IN ({{hostname}}) FACET hostname, mountPoint LIMIT MAX"
                      }
                    ],
                    "null_values": [],
